<div class="min-h-screen bg-[var(--hx-bg)] px-4 py-10 text-[var(--hx-ink)] sm:px-6 lg:px-8">
  <div class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-xl items-center">
    <section class="glass-panel w-full p-6 sm:p-8">
      <div class="text-xs uppercase tracking-[0.28em] text-[var(--hx-mute)]">Recovery</div>
      <h1 class="mt-3 font-display text-4xl">Choose a new password</h1>
      <.form
        for={@form}
        id="password-reset-form"
        action={~p"/password-reset/#{@token}"}
        method="post"
        class="mt-6 space-y-4"
      >
        <input type="hidden" name="_method" value="put" />
        <.input
          field={@form[:password]}
          type="password"
          label="New password"
          autocomplete="new-password"
          required
        />
        <.input
          field={@form[:password_confirmation]}
          type="password"
          label="Confirm password"
          autocomplete="new-password"
          required
        />
        <.button class="btn w-full justify-center rounded-lg border-0 bg-[var(--hx-accent)] text-black transition hover:scale-[1.01] hover:bg-[#ff875f]">
          <.icon name="hero-check" class="size-4" /> Update password
        </.button>
      </.form>
    </section>
  </div>
</div>
