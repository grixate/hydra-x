<div class="min-h-screen bg-[var(--hx-bg)] px-4 py-10 text-[var(--hx-ink)] sm:px-6 lg:px-8">
  <div class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-xl items-center">
    <section class="glass-panel w-full p-6 sm:p-8">
      <div class="text-xs uppercase tracking-[0.28em] text-[var(--hx-mute)]">Recovery</div>
      <h1 class="mt-3 font-display text-4xl">Reset password</h1>
      <p class="mt-4 text-sm leading-7 text-[var(--hx-mute)]">
        Hydra will create a local reset link in the server logs for now. Email delivery can be wired in later.
      </p>
      <.form
        for={@form}
        id="password-reset-request-form"
        action={~p"/password-reset"}
        method="post"
        class="mt-6 space-y-4"
      >
        <.input field={@form[:email]} type="email" label="Email" autocomplete="email" required />
        <.button class="btn w-full justify-center rounded-lg border-0 bg-[var(--hx-accent)] text-black transition hover:scale-[1.01] hover:bg-[#ff875f]">
          <.icon name="hero-envelope" class="size-4" /> Create reset link
        </.button>
      </.form>
      <.link
        navigate={~p"/login"}
        class="mt-6 inline-flex text-xs text-[var(--hx-mute)] transition hover:text-white"
      >
        Back to sign in
      </.link>
    </section>
  </div>
</div>
