<div class="min-h-screen bg-[var(--hx-bg)] px-4 py-10 text-[var(--hx-ink)] sm:px-6 lg:px-8">
  <div class="mx-auto grid min-h-[calc(100vh-5rem)] max-w-6xl items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
    <section class="space-y-6">
      <div class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.22em] text-[var(--hx-mute)]">
        <.icon name="hero-shield-check" class="size-4 text-[var(--hx-accent)]" /> Local auth
      </div>
      <div>
        <h1 class="font-display text-5xl leading-none sm:text-6xl">Sign in to Hydra</h1>
        <p class="mt-5 max-w-xl text-sm leading-7 text-[var(--hx-mute)]">
          Operator access is handled by local accounts on this instance. No external identity provider is required.
        </p>
      </div>
      <div class="grid max-w-2xl gap-3 sm:grid-cols-3">
        <div class="metric-card">
          <div class="metric-label">Mode</div>
          <div class="mt-3 text-lg">Self-hosted</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Hashing</div>
          <div class="mt-3 text-lg">Argon2id</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Signup</div>
          <div class="mt-3 text-lg">Invite-only</div>
        </div>
      </div>
    </section>

    <section class="glass-panel p-6 sm:p-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="text-xs uppercase tracking-[0.28em] text-[var(--hx-mute)]">Hydra-X</div>
          <h2 class="mt-3 font-display text-4xl">Operator sign-in</h2>
        </div>
        <Layouts.theme_toggle />
      </div>

      <p :if={@expired_reason} class="mt-4 rounded-lg border border-amber-300/20 bg-amber-300/10 px-3 py-2 text-xs text-amber-100">
        Previous session expired due to {@expired_reason}.
      </p>
      <p :if={@error} class="mt-4 rounded-lg border border-red-300/20 bg-red-300/10 px-3 py-2 text-sm text-red-100">
        {@error}
      </p>
      <p :if={!@operator_exists?} class="mt-4 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm text-[var(--hx-mute)]">
        No operator exists yet. Create the first account to claim this instance.
      </p>

      <.form for={@form} id="login-form" action={~p"/login"} method="post" class="mt-6 space-y-4">
        <.input field={@form[:email]} type="email" label="Email" autocomplete="email" required />
        <.input
          field={@form[:password]}
          type="password"
          label="Password"
          autocomplete="current-password"
          required
        />
        <.button class="btn w-full justify-center rounded-lg border-0 bg-[var(--hx-accent)] text-black transition hover:scale-[1.01] hover:bg-[#ff875f]">
          <.icon name="hero-arrow-right-end-on-rectangle" class="size-4" /> Sign in
        </.button>
      </.form>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--hx-mute)]">
        <.link navigate={~p"/password-reset"} class="transition hover:text-white">
          Forgot password?
        </.link>
        <.link :if={!@operator_exists?} navigate={~p"/register"} class="transition hover:text-white">
          Create first operator
        </.link>
      </div>

      <p class="mt-6 border-t border-white/10 pt-4 text-xs leading-6 text-[var(--hx-mute)]">
        Login throttle: {@throttle.max_attempts} attempts per {@throttle.window_seconds}s window.
        Session max {div(@session_max_age_seconds, 3600)}h, idle {div(@idle_timeout_seconds, 60)}m.
      </p>
    </section>
  </div>
</div>
